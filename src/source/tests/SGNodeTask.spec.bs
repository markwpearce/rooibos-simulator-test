import "pkg:/source/tests/BaseTestSuite.spec.bs"

namespace tests

  ' Minimal @SGNode suite: runs as an instance of the given node type (here, a Task). Every
  ' test in a node suite goes through a Promise whose .then() is dispatched via a Timer, so
  ' this exercises Timer ticking from inside a node test.
  @SGNode("AsyncTask")
  @suite("SGNodeTaskTests")
  class SGNodeTaskTests extends tests.BaseTestSuite

    @describe("sgnode task suite")

    @it("passes trivially while running as a Task node")
    function _()
      m.assertTrue(true)
    end function
  end class
end namespace
